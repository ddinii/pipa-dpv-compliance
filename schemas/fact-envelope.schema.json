{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/pipa-compliance/schema/fact-envelope-1.0.json",
  "title": "PIPA Fact Envelope v1.0",
  "type": "object",
  "required": [
    "fact_id",
    "subject_id",
    "activity_id",
    "ontology_class",
    "ontology_property",
    "value",
    "value_state",
    "source_type",
    "evidence",
    "schema_version"
  ],
  "properties": {
    "fact_id": {"type": "string", "pattern": "^F[123]-[0-9]{2}(?:[-_:].+)?$"},
    "subject_id": {"type": "string", "minLength": 1},
    "activity_id": {"type": ["string", "null"]},
    "ontology_class": {"type": "string", "minLength": 1},
    "ontology_property": {"type": ["string", "null"]},
    "value": {},
    "value_state": {"enum": ["confirmed", "unknown", "absent"]},
    "source_type": {
      "enum": [
        "policy_text",
        "incident_record",
        "notification_notice",
        "structured_form",
        "derived"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          {"required": ["text"]},
          {"required": ["field_path"]},
          {"required": ["offset"]}
        ],
        "additionalProperties": true
      }
    },
    "schema_version": {"const": "fact-1.0"}
  },
  "additionalProperties": true
}

