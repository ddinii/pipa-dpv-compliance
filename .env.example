# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# LLM integration
# NOTE: nothing loads this file automatically. Export these in your shell.
# Never put a real key in this file.

# Which extractor the compliance API uses: mock (default) or llm.
# mock returns a fixed synthetic scenario and costs nothing.
# llm calls the Claude API and is billed per request.
PIPA_EXTRACTOR=mock

# Required only when PIPA_EXTRACTOR=llm. The Anthropic SDK reads it directly.
ANTHROPIC_API_KEY=

# Optional model override for the real extractor. Defaults to claude-opus-5.
PIPA_EXTRACTOR_MODEL=
