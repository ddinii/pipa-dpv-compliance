# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# LLM integration
# NOTE: nothing loads this file automatically. The Anthropic SDK reads
# ANTHROPIC_API_KEY from the process environment, so export it in your shell
# rather than relying on .env. Never put a real key in this file.
ANTHROPIC_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
