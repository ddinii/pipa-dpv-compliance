# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# .env는 .gitignore에 포함되어 있어 git에 커밋되지 않습니다.

# Claude API 키 (없으면 MockExtractor가 자동으로 사용됩니다)
ANTHROPIC_API_KEY=

# 프론트엔드(Streamlit)가 바라볼 백엔드 주소 (기본값 사용 시 생략 가능)
PIPA_DPV_API_BASE=http://localhost:8000

# 국가법령정보센터 Open API 키(OC, 이메일 아이디 형식). 없으면 lawmonitor가
# 안내만 하고 건너뜁니다. 신청: https://open.law.go.kr/LSO/openApi/cuAskList.do
LAW_GO_KR_OC=
