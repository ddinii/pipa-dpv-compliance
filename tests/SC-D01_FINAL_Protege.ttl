@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pipa: <https://w3id.org/pipa-compliance/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://example.org/pipa-test/sc-d01#> .
@prefix test: <https://example.org/pipa-test/metadata#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/pipa-compliance/ontology> a owl:Ontology ;
    dct:created "2026-09-11"^^xsd:date ;
    dct:title "PIPA Compliance Process-Centered Ontology"@en,
        "개인정보 보호법 준수 지원 처리행위 중심 온톨로지"@ko ;
    rdfs:comment "PoC Freeze 문서의 P0 Rule/Fact와 처리행위 중심 모델링 원칙을 반영한 Protégé 호환 OWL 2 Turtle 온톨로지이다. 법적 판단을 확정하지 않는다."@ko ;
    owl:versionIRI <https://w3id.org/pipa-compliance/ontology/1.0> ;
    owl:versionInfo "1.0" .

pipa:PIPA_Art15_Para2_Item1 a pipa:PIPAArticle ;
    rdfs:label "개인정보 보호법 제15조제2항제1호"@ko ;
    pipa:articleNumber 15 ;
    pipa:provisionIdentifier "제15조제2항제1호" .

