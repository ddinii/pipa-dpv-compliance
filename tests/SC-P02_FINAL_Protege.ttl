@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pipa: <https://w3id.org/pipa-compliance/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://example.org/pipa-test/sc-p02-final#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sc:Incident_B24 a pipa:DataBreachIncident ;
    pipa:affectsPersonalInformation sc:Actual_EmailAddress ;
    pipa:triggersNotificationObligation sc:NotificationObligation_B24 ;
    pipa:hasNotificationNotice sc:Notice_B24 ;
    pipa:hasResponseMeasure sc:ControllerResponse,
        sc:Guidance,
        sc:PostIncidentMitigation,
        sc:RemedyProcedure ;
    pipa:hasSourceEvidence "사고 사실 입력: 뉴스레터 수신자 이메일 주소가 일반 참조(CC)로 노출됨" ;
    pipa:incidentDate "2026-09-05T14:30:00+09:00"^^xsd:dateTime .

<https://w3id.org/pipa-compliance/ontology> a owl:Ontology ;
    dct:created "2026-09-11"^^xsd:date ;
    dct:title "PIPA Compliance Process-Centered Ontology"@en,
        "개인정보 보호법 준수 지원 처리행위 중심 온톨로지"@ko ;
    rdfs:comment "PoC Freeze 문서의 P0 Rule/Fact와 처리행위 중심 모델링 원칙을 반영한 Protégé 호환 OWL 2 Turtle 온톨로지이다. 법적 판단을 확정하지 않는다."@ko ;
    owl:versionIRI <https://w3id.org/pipa-compliance/ontology/1.0> ;
    owl:versionInfo "1.0" .

pipa:Consent a owl:Class ;
    rdfs:label "Consent"@en,
        "동의"@ko ;
    rdfs:subClassOf pipa:LegalBasis .

