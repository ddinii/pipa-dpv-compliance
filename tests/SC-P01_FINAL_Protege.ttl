pipa:PIPA_Art34_Para1_Item1 a pipa:PIPAArticle ;
    rdfs:label "개인정보 보호법 제34조제1항제1호"@ko ;
    pipa:articleNumber 34 ;
    pipa:provisionIdentifier "제34조제1항제1호" .

