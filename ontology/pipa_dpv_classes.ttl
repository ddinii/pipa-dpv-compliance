@prefix : <https://example.org/pipa-dpv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix legal-kr: <https://w3id.org/dpv/legal/kr#> .

#################################################################
# PIPA-DPV Semantic Profile (1계층)
#
# W3C DPV(Data Privacy Vocabulary)의 legal-kr 확장을 기반으로,
# 한국 개인정보 보호법의 핵심 개념을 표준화한 온톨로지 스켈레톤입니다.
#
# ⚠️ 이 파일은 PoC 범위(처리방침 필수 기재사항 규칙, 핵심 11개+조건부 3개)에
#    필요한 최소 클래스만 정의합니다. 전체 법 조문을 온톨로지화하지 않습니다.
#
# legal-kr:law-PIPA 는 DPV 2.3 legal-kr 확장에 이미 등록된 개체(dpv:Law)로,
# 법률/감독기관 식별 수준에 머물러 있습니다. 이 파일은 그 아래에 실제 세부
# 규칙(:Purpose, :Retention 등)을 채워 legal-kr을 고도화하는 것이 목적이므로,
# 온톨로지 헤더에서 legal-kr:law-PIPA 를 명시적으로 참조합니다.
#
# Protégé에서 열어서 팀원들이 Class/Property/Individual을 추가・수정할 수
# 있습니다. File > Open > 이 .ttl 파일을 선택하세요.
#################################################################

<https://example.org/pipa-dpv> rdf:type owl:Ontology ;
    rdfs:label "PIPA-DPV: Korean PIPA Machine-Readable Rules Profile"@ko ;
    rdfs:comment "W3C DPV legal-kr 확장을 고도화한 한국 개인정보 보호법 온톨로지 (PoC)"@ko ;
    rdfs:seeAlso legal-kr:law-PIPA ;
    owl:imports dpv:, legal-kr: .

#################################################################
# 핵심 클래스 (dpv: 네임스페이스와 정합성을 갖도록 subClassOf 연결)
#################################################################

:PersonalData rdf:type owl:Class ;
    rdfs:subClassOf dpv:PersonalData ;
    rdfs:label "개인정보"@ko ;
    rdfs:comment "개인정보 보호법상 개인정보에 해당하는 데이터 클래스"@ko .

:SensitiveData rdf:type owl:Class ;
    rdfs:subClassOf :PersonalData, dpv:SpecialCategoryPersonalData ;
    rdfs:label "민감정보"@ko .

:Purpose rdf:type owl:Class ;
    rdfs:subClassOf dpv:Purpose ;
    rdfs:label "처리목적"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제1호" .

:Retention rdf:type owl:Class ;
    rdfs:subClassOf dpv:hasRetentionPeriod ;
    rdfs:label "보유기간"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제2호" .

:ThirdPartyProvision rdf:type owl:Class ;
    rdfs:subClassOf dpv:ThirdPartyDisclosure ;
    rdfs:label "제3자 제공"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제3호" .

:Outsourcing rdf:type owl:Class ;
    rdfs:label "처리위탁"@ko ;
    rdfs:comment "legal-kr 확장에 아직 존재하지 않아 신규 정의가 필요한 개념 (본 정책의 고도화 대상)"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제4호" .

:Destruction rdf:type owl:Class ;
    rdfs:subClassOf dpv:TechnicalOrganisationalMeasure ;
    rdfs:label "파기절차"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제3호의2" .

:CrossBorderTransfer rdf:type owl:Class ;
    rdfs:subClassOf dpv:ThirdCountryTransfer ;
    rdfs:label "국외이전"@ko ;
    :legalBasis "개인정보 보호법 제28조의8(국외이전 요건), 같은 법 제30조제1항제8호·시행령 제31조제1항제2호(처리방침 기재의무)" .

:ConsentWithdrawal rdf:type owl:Class ;
    rdfs:subClassOf dpv:Consent ;
    rdfs:label "동의철회"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제5호" .

:DataSubjectRight rdf:type owl:Class ;
    rdfs:subClassOf dpv:DataSubjectRight ;
    rdfs:label "정보주체 권리"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제5호" .

:PrivacyOfficer rdf:type owl:Class ;
    rdfs:label "개인정보보호책임자"@ko ;
    rdfs:comment "legal-kr 확장 고도화 대상 — 국내 특유 제도 (EU GDPR의 DPO와 유사하나 별도 개념)"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제6호" .

:AutoCollectionDevice rdf:type owl:Class ;
    rdfs:label "자동 수집 장치(쿠키 등)"@ko ;
    rdfs:comment "legal-kr 확장 고도화 대상 — dpv: 매핑은 팀원 검토 필요"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제7호" .

:SensitiveDataDisclosureChoice rdf:type owl:Class ;
    rdfs:subClassOf :SensitiveData ;
    rdfs:label "민감정보 공개가능성 및 비공개 선택방법"@ko ;
    rdfs:comment "민감정보를 처리하는 경우에만 해당(해당되는 경우에만 정한다) — dpv: 매핑은 팀원 검토 필요"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제3호의3" .

:PseudonymizedDataProcessing rdf:type owl:Class ;
    rdfs:label "가명정보 처리"@ko ;
    rdfs:comment "가명정보를 처리하는 경우에만 해당(해당되는 경우에만 정한다) — legal-kr/dpv: 매핑은 팀원 검토 필요"@ko ;
    :legalBasis "개인정보 보호법 제30조제1항제4호의2" .

#################################################################
# Provenance(출처 추적) 프로퍼티
# — "AI가 왜 이렇게 판단했는가"를 역추적하기 위한 핵심 장치
#################################################################

:legalBasis rdf:type owl:DatatypeProperty ;
    rdfs:label "관련 법조문"@ko ;
    rdfs:comment "법률 -> 조 -> 시행령 -> 고시 -> PIPA-DPV Rule ID 순으로 추적 가능하도록 기록"@ko ;
    rdfs:range xsd:string .

:ruleId rdf:type owl:DatatypeProperty ;
    rdfs:label "대응 Rule Engine 규칙 ID"@ko ;
    rdfs:comment "backend/rules/rule_engine.py 의 Rule.rule_id 와 매핑됨"@ko ;
    rdfs:range xsd:string .

#################################################################
# TODO(팀원 작업 항목)
#   1. [완료 2026-08-26] 각 :legalBasis 값을 국가법령정보센터・casenote.kr 대조로 검증
#      (개인정보 보호법 법률 제20897호, 2025.4.1. 개정 기준). 법 개정 시 재검증 필요.
#   2. [완료 2026-08-26] legal-kr prefix URI를 실제 DPV 2.3 소스(w3id.org)로 정정,
#      온톨로지 헤더가 legal-kr:law-PIPA 를 실제로 참조하도록 연결. 개별 클래스
#      단위 연결(예: 각 Rule -> legal-kr:law-PIPA)은 아직 미적용, 향후 고도화 대상.
#   3. Outsourcing, PrivacyOfficer, AutoCollectionDevice, SensitiveDataDisclosureChoice,
#      PseudonymizedDataProcessing 등 legal-kr에 없는 한국 특유 개념 정식 제안
#   4. SHACL Shape 파일 추가하여 Protégé 밖에서도 규칙 검증 가능하게 확장
#################################################################
